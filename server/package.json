{
  "name": "lifewellfhp-server",
  "version": "1.0.0",
  "private": true,
  "description": "LifeWell Family Health & Psychiatry — Node.js API",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:api": "node scripts/api-test.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "verify": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "cors": "2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "9.0.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "22.18.6",
    "@types/nodemailer": "6.4.17",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
