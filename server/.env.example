# LifeWell API — copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call this API (site + admin).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.lifewellfhp.com,https://lifewellfhp.com,https://lifewellfhp-client.vercel.app,https://lifewellfhp-admin.vercel.app

# Admin JWT signing secret. REQUIRED — no default, the server refuses to
# boot without it. Set a random value at least 32 characters long in every
# environment (dev, staging, production each need their own).
ADMIN_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# ---------------------------------------------------------------- contact ---
# Inbox that receives contact-form notifications.
CONTACT_EMAIL=contact@lifewellfhp.com
MAIL_FROM="LifeWell Family Health & Psychiatry <noreply@lifewellfhp.com>"

# mail.lifewellfhp.com must have an A record to the AccuWeb server
# (216.245.210.122). If it ever points at Vercel again, SMTP will fail —
# fall back to ssdlinuxld01.accuwebhosting.com in that case.
SMTP_HOST=mail.lifewellfhp.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@lifewellfhp.com
SMTP_PASSWORD=

# ------------------------------------------------------------- newsletter ---
NEWSLETTER_PROVIDER=none
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

# ------------------------------------------------------------ rate limits ---
RATE_LIMIT_CONTACT=5
RATE_LIMIT_NEWSLETTER=3
# Admin login attempts per IP per 15-minute window (counts both successes
# and failures, so a scripted probe can't loop freely).
RATE_LIMIT_ADMIN_LOGIN=5

# --------------------------------------------------------------- supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional labels for admin analytics panel
GA4_MEASUREMENT_ID=
GOOGLE_SEARCH_CONSOLE_SITE=

# After an admin Save, ping these public sites to drop Next.js cache.
# Comma-separated. Defaults also include CORS origins that look like the client.
CLIENT_REVALIDATE_URLS=https://lifewellfhp-client.vercel.app,https://www.lifewellfhp.com
REVALIDATE_SECRET=

# First admin seed (npm run seed:admin)
SEED_ADMIN_EMAIL=admin@lifewellfhp.com
SEED_ADMIN_PASSWORD=ChangeMeNow!2026
SEED_ADMIN_NAME=LifeWell Super Admin
