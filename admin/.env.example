NEXT_PUBLIC_API_URL=https://lifewellfhp-server.vercel.app
NEXT_PUBLIC_SITE_URL=https://www.lifewellfhp.com
# Next.js app that actually serves /images (www is still WordPress).
NEXT_PUBLIC_ASSET_URL=https://lifewellfhp-client.vercel.app
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_SEARCH_CONSOLE_SITE=

# Must match the server's ADMIN_JWT_SECRET exactly — middleware.ts verifies
# the session JWT's signature itself (Edge runtime, no network round-trip)
# before rendering any page except /login. REQUIRED; there is no default.
ADMIN_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-characters

# Must match the server's ADMIN_PROXY_SECRET exactly. Proves to Express that
# the client IP this app declares in the x-lifewell-client-ip header (see
# lib/session.ts) genuinely came through this app's own proxy, not a direct
# caller forging the header — used for IP-keyed rate limiting only. Optional:
# when unset, the proxy simply doesn't send that header and Express falls
# back to its own req.ip, same as before this existed.
ADMIN_PROXY_SECRET=

# Only needed if NEXT_PUBLIC_API_URL points at a Vercel-Deployment-Protected
# URL (e.g. the server project's own Preview deployments) — Vercel's SSO wall
# blocks ALL incoming requests to a protected deployment, including this
# proxy's own server-to-server calls, not just outside browsers. Set this to
# the server project's "Protection Bypass for Automation" secret (Vercel
# project settings -> Deployment Protection) to let this proxy through. Not
# needed in production, where NEXT_PUBLIC_API_URL points at the public,
# unprotected production API.
VERCEL_PROTECTION_BYPASS_SECRET=

# Local development (optional):
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_ASSET_URL=http://localhost:3000
