{
  "name": "lifewellfhp-client",
  "version": "1.0.0",
  "private": true,
  "description": "LifeWell Family Health & Psychiatry — Next.js frontend",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:structure": "node scripts/check-page-structure.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:vercel && npm run check:contrast && npm run build",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:forms": "node scripts/check-forms.mjs",
    "check:coverage": "node scripts/check-content-coverage.cjs",
    "check:hero": "node scripts/shot-hero.mjs",
    "check:deeplinks": "node scripts/check-deeplinks.mjs",
    "check:deeplinks:prod": "node scripts/check-deeplinks.prod.mjs",
    "check:drift": "node scripts/check-content-drift.mjs",
    "check:vercel": "node scripts/check-vercel-config.mjs"
  },
  "dependencies": {
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.23",
    "playwright": "1.62.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2"
  },
  "overrides": {
    "sharp": "0.35.3",
    "postcss": "8.5.26"
  }
}
