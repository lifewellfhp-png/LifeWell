# LifeWell frontend — copy to .env.local and fill in.
# Only NEXT_PUBLIC_* values are exposed to the browser; keep secrets out.
#
# These are read at BUILD time and baked into the output. Changing them in
# Vercel requires a redeploy, not just a restart.

# Base URL of the Node API (server/).
NEXT_PUBLIC_API_URL=https://lifewellfhp-server.vercel.app

# Canonical site origin. Drives metadata, canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.lifewellfhp.com

# Local development (optional):
# NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Ads conversion ID (format: AW-XXXXXXXXX). Leave blank to disable the
# tag entirely (no script is loaded when unset). gtag.js only — no GTM, no GA4.
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Per-event conversion labels from the Google Ads dashboard (the part after
# the slash in "AW-XXXXXXXXX/AbC-D_efG-h12_3456"). Each is independently
# optional — an event with no label configured simply never fires.
NEXT_PUBLIC_GOOGLE_ADS_LABEL_CONTACT=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_PHONE_CLICK=
NEXT_PUBLIC_GOOGLE_ADS_LABEL_BOOKING_CLICK=

# Shared with the API so admin Save can drop this site's cache. Optional.
REVALIDATE_SECRET=
